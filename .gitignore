node_modules/
dist/
dist-server/
release/
*.local
.env
.env.*
!.env.example
.DS_Store
.vercel
scratch/

# JetBrains IDE project files (per-developer, not shared)
.idea/

# load-harness output (scripts/loadtest.ts --json); sweeps are evidence, not source
.loadtest-out/

.coord.json
.coord.retired.json
scripts/.mm-fuzz-baseline.json

# generated by scripts/smokeshard.mjs — one copy of smoke.ts's preamble per shard, written
# next to the original so relative imports and readFileSync('src/...') resolve identically,
# and deleted on exit. Ignored so a killed run cannot leave 1.2 MB of generated test code
# staged. The cost table beside it IS tracked: it is a measurement, and a fresh clone that
# has it packs the shards well on the first run instead of after a calibration.
scripts/.smokeshard-*.ts

# Serena MCP per-developer project config
.serena/
.impeccable/

# Zenith is not public yet: its packed packages stay on the machine that packed them
# (scripts/vendor-zenith.mjs). Never commit them.
vendor/zenith/*.tgz
