    { "id": "preload", "kind": "command", "name": "shootAll", "args": { "count": 4 }, "timeoutS": 4 },
    { "id": "toGarden", "kind": "path", "segments": [{ "kind": "line", "from": "current", "to": { "xIn": -46, "yIn": -52 } }], "heading": { "mode": "linear", "fromRad": 3.1416, "toRad": 4.7124 } },
    { "id": "drop", "kind": "path", "segments": [{ "kind": "line", "from": "current", "to": { "xIn": -46, "yIn": -59.8 } }], "heading": { "mode": "constant", "headingRad": -1.5708 } },
    { "id": "sweep", "kind": "path", "timeoutS": 3, "speedFraction": 0.3, "segments": [{ "kind": "line", "from": "current", "to": { "xIn": -61.5, "yIn": -59.8 } }], "heading": { "mode": "constant", "headingRad": -1.5708 },
      "markers": [{ "at": { "t": 0 }, "command": { "name": "setIntake", "args": { "side": "BOTH", "state": "FORWARD" } } }],
      "endCondition": { "condition": "hopperFull" } },
    { "id": "stopIntake", "kind": "command", "name": "setIntake", "args": { "side": "BOTH", "state": "STOP" } },
