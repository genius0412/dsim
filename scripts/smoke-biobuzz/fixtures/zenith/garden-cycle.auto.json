{
  "formatVersion": 3,
  "name": "garden-cycle",
  "title": "Preload, sweep the garden, score again, park",
  "alliance": "RED",
  "start": { "pose": { "xIn": -34, "yIn": -63.17, "headingRad": 1.5708 }, "holds": { "pollen": 4 } },
