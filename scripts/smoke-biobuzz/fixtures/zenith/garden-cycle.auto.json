    { "id": "cycle", "kind": "command", "name": "shootAll", "args": { "count": 4 }, "timeoutS": 3 },
    { "id": "park", "kind": "path", "segments": [{ "kind": "bezier", "from": "current", "control": [{ "xIn": -50, "yIn": -40 }, { "xIn": -54, "yIn": 10 }], "to": { "xIn": -59.5, "yIn": 35 } }], "heading": { "mode": "tangent" } }
  ]
